{
  "schemaVersion": 1,
  "about": "loom/recipe.py::compose_call, the one recipe-composition rule the browser runtime mirrors (browserLoom.ts resolveGenerationSettings). Each case: the call (steering, thinking, a sampling block of the SamplingConfig fields it sets), an optional cast member and regen anchor (a recipe's steering, thinking, system_prompt when captured, and the sampling fields it sets), an optional modifier string (deterministic modes and partial recipes only; reseed draws entropy), and the composed steering, thinking, system_prompt (absent: inherit) and the sampling fields that are set. Sampling ranks cast < anchor < call < modifier; steering, thinking and the system prompt rank cast < call < anchor < modifier; the seed resolves modifier > call > anchor > cast; observation knobs come from the call. Python: tests/browser/test_browser_parity.py.",
  "cases": [
    {
      "name": "no tiers is the call itself",
      "call": {
        "steering": "0.5 calm",
        "thinking": true,
        "sampling": {
          "temperature": 0.4,
          "seed": 2
        }
      },
      "expected": {
        "steering": "0.5 calm",
        "thinking": true,
        "sampling": {
          "temperature": 0.4,
          "seed": 2
        }
      }
    },
    {
      "name": "cast fills what the call leaves unset",
      "call": {
        "steering": null,
        "thinking": null,
        "sampling": {
          "temperature": 0.4
        }
      },
      "cast": {
        "steering": "0.2 warm",
        "thinking": true,
        "sampling": {
          "top_k": 20,
          "presence_penalty": 0.5,
          "seed": 3
        }
      },
      "expected": {
        "steering": "0.2 warm",
        "thinking": true,
        "sampling": {
          "temperature": 0.4,
          "top_k": 20,
          "seed": 3,
          "presence_penalty": 0.5
        }
      }
    },
    {
      "name": "a regenerate that sends no sampling reproduces the anchor",
      "call": {
        "steering": "",
        "thinking": null,
        "sampling": null
      },
      "anchor": {
        "steering": "0.3 honest",
        "thinking": false,
        "system_prompt": "Anchor prompt",
        "sampling": {
          "temperature": 0.7,
          "top_p": 0.5,
          "max_tokens": 40,
          "stop": [
            "\n"
          ],
          "seed": 11
        }
      },
      "modifier": "unsteered",
      "expected": {
        "steering": "",
        "thinking": false,
        "sampling": {
          "temperature": 0.7,
          "top_p": 0.5,
          "max_tokens": 40,
          "seed": 11,
          "stop": [
            "\n"
          ]
        },
        "system_prompt": "Anchor prompt"
      }
    },
    {
      "name": "the call's sampling outranks the anchor's; the anchor fills the rest",
      "call": {
        "steering": "0.9 calm",
        "thinking": true,
        "sampling": {
          "temperature": 0.9,
          "top_p": 0.95,
          "top_k": 40,
          "max_tokens": 24,
          "return_top_k": 5
        }
      },
      "anchor": {
        "steering": "0.3 honest",
        "thinking": false,
        "system_prompt": "Anchor prompt",
        "sampling": {
          "temperature": 0.7,
          "top_p": 0.5,
          "max_tokens": 40,
          "stop": [
            "\n"
          ],
          "seed": 11
        }
      },
      "modifier": "cool",
      "expected": {
        "steering": "0.3 honest",
        "thinking": false,
        "sampling": {
          "temperature": 0.3,
          "top_p": 0.95,
          "top_k": 40,
          "max_tokens": 24,
          "seed": 11,
          "stop": [
            "\n"
          ],
          "return_top_k": 5
        },
        "system_prompt": "Anchor prompt"
      }
    },
